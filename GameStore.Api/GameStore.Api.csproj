<!-- 
.csproj File Overview:
This is an MSBuild project file that defines how your C# project should be compiled, what dependencies it has,
and what kind of application it produces. MSBuild is Microsoft's build platform that processes this file.
-->

<!-- Project Root Element with SDK Attribute -->
<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- 
  The 'Sdk' attribute specifies which .NET SDK template to use for this project
  "Microsoft.NET.Sdk.Web" is specifically for web applications and includes:
  
  What Microsoft.NET.Sdk.Web provides automatically:
  1. References to ASP.NET Core framework assemblies
  2. Web-specific build targets and tasks
  3. Default item inclusions (automatically includes .cs files, static web assets, etc.)
  4. Publishing targets for web deployment
  5. Development server integration (Kestrel)
  6. Static file serving capabilities
  7. Razor view compilation (if using MVC/Razor Pages)
  8. wwwroot folder handling for static assets
  
  Alternative SDKs you could use:
  - Microsoft.NET.Sdk (for console apps, class libraries)
  - Microsoft.NET.Sdk.Worker (for background services)
  - Microsoft.NET.Sdk.Razor (for Razor class libraries)
  
  The SDK system uses "convention over configuration" - it provides sensible defaults
  so you don't have to manually configure everything
  -->

  <!-- PropertyGroup: Contains project-wide settings and metadata -->
  <PropertyGroup>
    <!-- 
    PropertyGroup elements contain MSBuild properties that control compilation,
    packaging, and runtime behavior. These are key-value pairs that MSBuild uses
    during the build process.
    -->
    
    <!-- Target Framework Specification -->
    <TargetFramework>net8.0</TargetFramework>
    <!-- 
    Specifies which version of .NET this project targets
    "net8.0" means .NET 8.0 (released November 2023)
    
    What this enables:
    1. Access to .NET 8.0 Base Class Library (BCL) APIs
    2. C# 12 language features (if using default language version)
    3. .NET 8.0 runtime optimizations and performance improvements
    4. Compatibility with .NET 8.0 hosting environments
    5. Access to ASP.NET Core 8.0 features and APIs
    
    Target Framework Moniker (TFM) options:
    - net8.0 (latest LTS - Long Term Support until 2026)
    - net7.0 (Standard Term Support - supported for 18 months)
    - net6.0 (Previous LTS - supported until 2024)
    - netstandard2.0/2.1 (for libraries targeting multiple .NET implementations)
    
    Why choose .NET 8.0:
    - Performance improvements (up to 20% faster than .NET 6)
    - New language features and APIs
    - Enhanced minimal APIs support
    - Better container and cloud-native support
    - Long-term support lifecycle
    -->
    
    <!-- Nullable Reference Types -->
    <Nullable>enable</Nullable>
    <!-- 
    Enables nullable reference types across the entire project
    This is a C# 8.0+ feature that helps prevent null reference exceptions
    
    What this does:
    1. Reference types (classes, interfaces, delegates) are non-nullable by default
    2. To allow null, you must explicitly use nullable syntax: string? nullableString
    3. Compiler provides warnings when you might be dereferencing null
    4. Helps catch potential null reference bugs at compile time
    
    Nullable annotation context affects:
    - Variable declarations: string name vs string? name
    - Method parameters: void Method(string value) vs void Method(string? value)
    - Return types: string GetName() vs string? GetName()
    
    Options:
    - enable: Full nullable reference type checking
    - disable: Traditional C# behavior (pre-C# 8.0)
    - warnings: Enable warnings but allow nullable reference types
    - annotations: Enable nullable annotations but minimal warnings
    
    Benefits:
    1. Compile-time null safety
    2. Self-documenting code (intent about nullability is explicit)
    3. Better IDE support with null-flow analysis
    4. Reduced runtime null reference exceptions
    5. Improved API design clarity
    -->
    
    <!-- Implicit Using Statements -->
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 
    Automatically includes common 'using' statements based on project SDK type
    This reduces boilerplate code by implicitly adding frequently used namespaces
    
    For Microsoft.NET.Sdk.Web projects, these usings are automatically added:
    - using System;
    - using System.Collections.Generic;
    - using System.IO;
    - using System.Linq;
    - using System.Net.Http;
    - using System.Threading;
    - using System.Threading.Tasks;
    - using Microsoft.AspNetCore.Builder;
    - using Microsoft.AspNetCore.Hosting;
    - using Microsoft.AspNetCore.Http;
    - using Microsoft.AspNetCore.Routing;
    - using Microsoft.Extensions.Configuration;
    - using Microsoft.Extensions.DependencyInjection;
    - using Microsoft.Extensions.Hosting;
    - using Microsoft.Extensions.Logging;
    
    What this means for your code:
    1. You don't need to write 'using System;' at the top of files
    2. Common types like List<T>, Task, HttpClient are available without explicit using
    3. ASP.NET Core types like WebApplication, IServiceCollection are available
    4. Less repetitive code across your project files
    
    You can still add explicit using statements for:
    - Third-party libraries
    - Less common System namespaces
    - Your own project namespaces
    
    To see what's implicitly included, you can run: dotnet build -v detailed
    -->
  </PropertyGroup>

  <!-- ItemGroup: Contains project items like package references, project references, files -->
  <ItemGroup>
    <!-- 
    ItemGroup contains collections of items that MSBuild processes
    Common item types:
    - PackageReference: NuGet package dependencies
    - ProjectReference: References to other projects in your solution
    - Compile: Source code files (usually automatic with SDK)
    - Content: Files to copy to output directory
    - None: Files to include in project but not compile or copy
    -->
    
    <!-- NuGet Package Reference -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.8">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="MinimalApis.Extensions" Version="0.11.0" />
    <!-- 
    PackageReference adds a dependency on a NuGet package
    
    "MinimalApis.Extensions" package provides:
    1. Enhanced endpoint mapping capabilities for minimal APIs
    2. Additional extension methods for routing and HTTP handling
    3. Utilities for parameter binding and validation
    4. Enhanced OpenAPI/Swagger integration for minimal APIs
    5. Simplified error handling and response formatting
    
    Package Management Details:
    - Include="MinimalApis.Extensions": The package ID from NuGet.org
    - Version="0.11.0": Specific version to install (exact version pinning)
    
    Version Specification Options:
    - "0.11.0": Exact version (recommended for production)
    - "0.11.*": Latest patch version of 0.11.x
    - "[0.11.0, 1.0.0)": Version range (>= 0.11.0 but < 1.0.0)
    
    How NuGet Resolution Works:
    1. MSBuild reads PackageReference during restore
    2. NuGet downloads package and dependencies from configured feeds
    3. Package assemblies are added to compilation and runtime
    4. Package dependencies are transitively included
    5. Assets are extracted to global packages folder (~/.nuget/packages)
    
    Package Benefits:
    1. Code reuse without copying source
    2. Automatic dependency management
    3. Versioning and update management
    4. Global caching reduces storage
    5. Package signing and security validation
    
    Development Workflow:
    1. dotnet restore: Downloads packages based on PackageReference
    2. dotnet build: Compiles code with package references
    3. dotnet publish: Includes necessary package assemblies in output
    -->
  </ItemGroup>

</Project>

<!-- 
MSBuild Processing Overview:
When you run 'dotnet build' or 'dotnet run', here's what happens:

1. Project Discovery:
   - MSBuild locates and parses this .csproj file
   - Resolves SDK imports (Microsoft.NET.Sdk.Web brings in additional .targets files)
   - Processes PropertyGroup and ItemGroup elements

2. Package Restoration (if needed):
   - Downloads MinimalApis.Extensions 0.11.0 and its dependencies
   - Stores packages in global cache (~/.nuget/packages/)
   - Creates project.assets.json with dependency graph

3. Compilation Phase:
   - C# compiler (Roslyn) processes all .cs files in project
   - Applies nullable reference type checking (due to <Nullable>enable</Nullable>)
   - Includes implicit usings (due to <ImplicitUsings>enable</ImplicitUsings>)
   - References .NET 8.0 assemblies and NuGet package assemblies
   - Generates IL (Intermediate Language) bytecode

4. Output Generation:
   - Creates executable/library in bin/Debug/net8.0/ or bin/Release/net8.0/
   - Copies necessary runtime dependencies
   - Generates runtime configuration files (*.runtimeconfig.json)
   - For web projects, prepares for hosting in Kestrel server

Build Configuration Impact:
- Debug builds include debugging symbols and disable optimizations
- Release builds enable optimizations and may trim unused code
- Target framework determines available APIs and runtime behavior
- SDK type determines build targets and default behaviors

This project file follows modern .NET conventions:
1. SDK-style project format (concise, declarative)
2. Latest language features enabled (nullable reference types, implicit usings)
3. Current LTS framework version (.NET 8.0)
4. Minimal configuration (relies on SDK defaults)
5. Clear dependency management (explicit package versions)
-->